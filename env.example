GOOGLE_API_KEY=your_google_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# LLM provider to use: "gemini" (default), "deepseek", or "omniroute"
LLM_PROVIDER=gemini
MOCK_LLOOM=false

# Optional: run GLEN trigger detection on a remote GPU instead of locally
# (e.g. a Kaggle notebook exposed via ngrok). When set, backend_service's
# extraction step POSTs to {GLEN_REMOTE_URL}/detect instead of running GLEN
# in-process. Leave unset to run GLEN locally (CPU or local GPU).
# Note: a free ngrok tunnel's URL changes every time the Kaggle kernel
# restarts, so this needs updating each session.
GLEN_REMOTE_URL=